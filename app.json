{
  "expo": {
    "name": "Receipt Splitter",
    "slug": "receipt-splitter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EDE6D8"
    },
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": true,
      "bundleIdentifier": "eu.splitr.app",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to scan your receipt.",
        "NSPhotoLibraryUsageDescription": "We need photo library access to import receipt photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "eu.splitr.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "We need photo library access to import receipt photos.",
          "cameraPermission": "We need camera access to scan your receipt."
        }
      ]
    ]
  }
}

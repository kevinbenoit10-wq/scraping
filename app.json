{
  "expo": {
    "name": "Receipt Splitter",
    "slug": "receipt-splitter",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EDE6D8"
    },
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": true,
      "bundleIdentifier": "eu.splitr.bills",
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to scan your receipt.",
        "NSPhotoLibraryUsageDescription": "We need photo library access to import receipt photos.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "eu.splitr.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-image-picker",
        {
          "photoLibraryUsageDescription": "We need photo library access to import receipt photos.",
          "cameraPermissionText": "We need camera access to scan your receipt."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "133ea419-c336-4cef-bb85-cbf5a875b458"
      }
    }
  }
}
